# Line endings: LF in the repository and in every working copy, whatever the
# git settings of the machine. The Docker images run on Linux, where a script
# with CRLF line endings does not run.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files are never converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xls binary
*.xlsx binary
*.woff binary
*.woff2 binary
