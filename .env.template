# Easy Diligence : modèle de configuration.
#
# Copier ce fichier en backend/.env et le remplir. Ne jamais committer la copie.
# VITE_API_URL (dernière section) va dans frontend/.env.
# Chaque variable est commentée avec sa valeur par défaut. Une ligne laissée en
# commentaire garde cette valeur.

# --- Base de données PostgreSQL (obligatoire) -----------------------------------
# Les POSTGRES_* servent à la fois à l'image PostgreSQL et au backend, qui en
# déduit l'URL de connexion. L'application refuse de démarrer sans eux.
POSTGRES_USER=easy_diligence
# Mot de passe de la base. À générer, par exemple avec : openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=easy_diligence
# Hôte de la base : « db » est le service de docker compose. En local : localhost.
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
# Ou bien une URL complète, qui prime sur les POSTGRES_* :
# DATABASE_URL=postgresql+psycopg://<utilisateur>:<mot de passe>@<hôte>:5432/<base>

# --- OpenAI (obligatoire) -------------------------------------------------------
# Clé d'API du projet OpenAI facturé pour les traitements. L'application refuse
# de démarrer sans elle.
OPENAI_API_KEY=
# Modèle utilisé pour les réponses et les synthèses. Le moteur adapte ses
# paramètres aux modèles à raisonnement (pas de temperature, reasoning.effort,
# budget de sortie plus large). gpt-4o fonctionne aussi. Défaut du code : gpt-4o.
OPENAI_MODEL=gpt-5.6-luna

# --- Sécurité (obligatoire) -----------------------------------------------------
# Clé de signature des jetons JWT, d'au moins 32 caractères.
# À générer avec : openssl rand -hex 32
# L'application refuse de démarrer sans elle.
JWT_SECRET_KEY=
# Algorithme de signature : HS256, HS384 ou HS512.
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7
# Connexion : après LOGIN_MAX_ATTEMPTS échecs en LOGIN_WINDOW_SECONDS secondes,
# le compte est refusé (code 429) jusqu'à la fin de la fenêtre. Une même adresse
# IP a droit à quatre fois plus d'échecs.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_SECONDS=900

# --- Application ----------------------------------------------------------------
# Nom affiché dans la documentation de l'API, les e-mails, et auteur des PDF.
# APP_NAME=Easy Diligence
# DEBUG=false
# Niveau des journaux de l'application : DEBUG, INFO, WARNING ou ERROR. Les
# bibliothèques tierces n'écrivent qu'à partir de WARNING.
# LOG_LEVEL=INFO
# Documentation interactive de l'API (/docs, /redoc, /openapi.json). Fermée par
# défaut : elle décrit chaque endpoint à quiconque joint le serveur. Pratique en
# développement.
# DOCS_ENABLED=false
# Origines autorisées à appeler l'API (liste JSON) : l'URL où le frontend est servi.
# Défaut : les ports locaux de Vite (5173 à 5179) et 3000.
# CORS_ORIGINS=["http://localhost:5173"]
# URL publique du frontend, utilisée dans les e-mails de réinitialisation du
# mot de passe.
# FRONTEND_URL=http://localhost:5173
# Bannière facultative (PNG ou JPEG) en tête des rapports PDF exportés.
# Vide : pas de bannière. Un chemin vers un fichier absent est journalisé puis ignoré.
# BRAND_BANNER_PATH=

# --- Fichiers envoyés -----------------------------------------------------------
# Taille maximale d'un fichier, en octets (défaut : 100 Mo).
# MAX_UPLOAD_SIZE=104857600
# Extensions acceptées pour les documents (liste JSON, sans le point). L'import
# de questionnaires a sa propre liste : xlsx, xls, csv, json.
# ALLOWED_EXTENSIONS=["pdf","doc","docx","pptx","txt","md","html","json","csv","xls","xlsx"]

# --- Cache (facultatif) ---------------------------------------------------------
# Cache Redis. Si Redis est injoignable, un cache en mémoire prend le relais.
# REDIS_URL=redis://localhost:6379/0

# --- E-mail (facultatif, pour la réinitialisation du mot de passe) -------------
# SMTP_HOSTNAME=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
# MAIL_FROM_NAME=Easy Diligence

# --- Moteur de réponses ---------------------------------------------------------
# Outil que le modèle doit appeler en premier sur chaque question :
# web_search (défaut, retenu après mesure), auto (le modèle choisit),
# none (rien n'est envoyé).
# TOOL_CHOICE=web_search
# Effort de raisonnement des modèles à raisonnement :
# none, low, medium, high, xhigh, max.
# Pour répondre aux questions (extraction depuis des documents déjà retrouvés) :
# REASONING_EFFORT=low
# Pour rédiger les synthèses (pure rédaction, là où le raisonnement paie) :
# SUMMARY_REASONING_EFFORT=medium
# Taille d'entrée (en tokens) au-delà de laquelle l'historique de la conversation
# est compacté côté OpenAI au lieu d'être tronqué en silence. 0 désactive.
# COMPACT_THRESHOLD=200000

# --- Limitation de débit (soupape, toutes les pauses désactivées par défaut) ----
# Les erreurs 429 sont déjà gérées par un backoff exponentiel et un disjoncteur.
# Pause après chaque question, en secondes :
# INTER_QUESTION_DELAY_SECONDS=0
# Taille d'un lot, et pause après chaque lot (en minutes) :
# MAX_QUESTIONS_PER_BATCH=6
# BATCH_SLEEP_MINUTES=0
# Pause après une question « lourde » (en secondes), et seuil de lourdeur (tokens) :
# HIGH_TOKEN_SLEEP_SECONDS=0
# TOKEN_THRESHOLD=50000

# --- Frontend (frontend/.env) ---------------------------------------------------
# URL de l'API backend, telle que le navigateur la voit.
VITE_API_URL=http://localhost:8000
