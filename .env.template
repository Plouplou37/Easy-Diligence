# Easy Diligence: configuration template.
#
# Copy this file and fill it in. Never commit the copy.
# - With Docker: as .env, at the root of the repository (docker compose reads it).
# - Run by hand: as backend/.env.
# The last section (VITE_*) is for the frontend: frontend/.env, optional.
# Each variable is commented with its default value. A line left commented out
# keeps that value.

# --- PostgreSQL database (required) ---------------------------------------------
# The POSTGRES_* variables serve both the PostgreSQL image and the backend, which
# builds the connection URL from them. The application refuses to start without
# them.
POSTGRES_USER=easy_diligence
# Database password. Generate one, for example with: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=easy_diligence
# Database host: "db" is the docker compose service (set by docker-compose.yml,
# as is the absence of DATABASE_URL). Run by hand: localhost.
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
# Or a full URL, which wins over the POSTGRES_* variables:
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>

# --- OpenAI (required) ----------------------------------------------------------
# API key of the OpenAI project billed for the runs. The application refuses to
# start without it.
OPENAI_API_KEY=
# Model used for the answers and the syntheses. The engine adapts its parameters
# to reasoning models (no temperature, reasoning.effort, a larger output
# budget). gpt-4o works too. Default in the code: gpt-4o.
OPENAI_MODEL=gpt-5.6-luna

# --- Security (required) --------------------------------------------------------
# Signing key of the JWT tokens, at least 32 characters.
# Generate it with: openssl rand -hex 32
# The application refuses to start without it.
JWT_SECRET_KEY=
# Signing algorithm: HS256, HS384 or HS512.
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7
# Login: after LOGIN_MAX_ATTEMPTS failures within LOGIN_WINDOW_SECONDS seconds,
# the account is refused (code 429) until the end of the window. One IP address
# is allowed four times as many failures.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_SECONDS=900

# --- Docker ---------------------------------------------------------------------
# Port of the machine on which the proxy serves the application (default: 8080).
# APP_PORT=8080

# --- Application ----------------------------------------------------------------
# Name shown in the API documentation and the e-mails, and author of the PDFs.
# APP_NAME=Easy Diligence
# DEBUG=false
# Log level of the application: DEBUG, INFO, WARNING or ERROR. Third-party
# libraries only log from WARNING up.
# LOG_LEVEL=INFO
# Interactive API documentation (/docs, /redoc, /openapi.json). Closed by
# default: it describes every endpoint to anyone who reaches the server. Handy
# in development.
# DOCS_ENABLED=false
# Origins allowed to call the API (JSON list): the URL where the frontend is
# served. Default: the local Vite ports (5173 to 5179) and 3000. Not needed with
# Docker: the proxy serves the application and the API on the same address.
# CORS_ORIGINS=["http://localhost:5173"]
# Public URL of the frontend, used in the password reset e-mails. With Docker:
# http://localhost:8080 (or the public address).
# FRONTEND_URL=http://localhost:5173
# Optional banner (PNG or JPEG) at the top of the exported PDF reports.
# Empty: no banner. A path to a missing file is logged, then ignored.
# With Docker, the branding/ folder of the repository is mounted at /app/branding:
# BRAND_BANNER_PATH=/app/branding/<file>
# BRAND_BANNER_PATH=
# Colors of the PDF report (#RRGGBB): headings and bands, secondary text, thin
# rules. And the notice printed at the foot of every page.
# PDF_PRIMARY_COLOR=#243B5E
# PDF_TEXT_COLOR=#4A4A4A
# PDF_RULE_COLOR=#E7EBF1
# PDF_FOOTER_NOTICE=PRIVATE AND CONFIDENTIAL — NOT FOR PUBLIC DISTRIBUTION

# --- Uploaded files -------------------------------------------------------------
# Maximum size of a file, in bytes (default: 100 MB).
# MAX_UPLOAD_SIZE=104857600
# Extensions accepted for documents (JSON list, without the dot). Questionnaire
# import has its own list: xlsx, xls, csv, json.
# ALLOWED_EXTENSIONS=["pdf","doc","docx","pptx","txt","md","html","json","csv","xls","xlsx"]

# --- Cache (optional) -----------------------------------------------------------
# Redis cache. If Redis cannot be reached, an in-memory cache takes over.
# REDIS_URL=redis://localhost:6379/0

# --- E-mail (optional, for password reset) --------------------------------------
# SMTP_HOSTNAME=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
# MAIL_FROM_NAME=Easy Diligence

# --- Answering engine -----------------------------------------------------------
# Tool the model must call first on each question:
# web_search (default, chosen after measurement), auto (the model chooses),
# none (nothing is sent).
# TOOL_CHOICE=web_search
# Reasoning effort of reasoning models:
# none, low, medium, high, xhigh, max.
# To answer the questions (extraction from documents already retrieved):
# REASONING_EFFORT=low
# To write the syntheses (pure writing, where reasoning pays off):
# SUMMARY_REASONING_EFFORT=medium
# Input size (in tokens) above which the conversation history is compacted on
# the OpenAI side instead of being silently truncated. 0 disables it.
# COMPACT_THRESHOLD=200000

# --- Rate limiting (safety valve, every pause disabled by default) --------------
# 429 errors are already handled by an exponential backoff and a circuit breaker.
# Pause after each question, in seconds:
# INTER_QUESTION_DELAY_SECONDS=0
# Batch size, and pause after each batch (in minutes):
# MAX_QUESTIONS_PER_BATCH=6
# BATCH_SLEEP_MINUTES=0
# Pause after a "heavy" question (in seconds), and the heaviness threshold (tokens):
# HIGH_TOKEN_SLEEP_SECONDS=0
# TOKEN_THRESHOLD=50000

# --- Frontend (frontend/.env, optional) -----------------------------------------
# The frontend calls the API with relative URLs, on /api: no URL to set. In
# development, the Vite server forwards /api to the backend, at this address:
# VITE_API_PROXY=http://localhost:8000
